---
import { createTranslator, getLocale } from "../i18n/ui";
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeading from "../components/SectionHeading.astro";
import ParentPromises from "../components/ParentPromises.astro";
import DodoVisual from "../components/DodoVisual.astro";
import CallToAction from "../components/CallToAction.astro";
import FAQ from "../components/FAQ.astro";
import Icon from "../components/Icon.astro";
import { getAppData } from "../data/app";
import { faqSchema } from "../utils/seo";
import { localizedPath } from "../utils/urls";
const locale = getLocale(Astro.url);
const t = createTranslator(locale);
const withBase = (path = "") => localizedPath(path, locale);
const { parentFaqs } = getAppData(locale);
const siteUrl = new URL(withBase(), Astro.site ?? Astro.url.origin);
const schema = faqSchema(parentFaqs, new URL("parents/", siteUrl).href);
---

<BaseLayout
  title={t("m132")}
  description={t("m133")}
  schema={schema}
>
  <section class="section parents-hero">
    <div class="container-shell">
      <nav class="breadcrumbs" aria-label={t("m134")}>
        <a href={withBase()}>{t("m135")}</a>
        <span aria-hidden="true">/</span>
        <span>{t("m136")}</span>
      </nav>
      <div class="split-layout">
        <div>
          <p class="eyebrow">{t("m136")}</p>
          <h1>
            {t("m137")}
            <br />
            <span class="text-teal">{t("m138")}</span>
          </h1>
          <span class="accent-line" aria-hidden="true"></span>
          <p class="hero-intro">
            {t("m139")}
          </p>
        </div>
        <DodoVisual trust message={t("m140")} eager />
      </div>
    </div>
  </section>
  <section id="approach" class="section section--navy">
    <div class="container-shell">
      <SectionHeading
        eyebrow={t("m141")}
        title={t("m142")}
        copy={t("m143")}
      />
      <ParentPromises full highlightPrivacy />
    </div>
  </section>
  <section id="parental-gate" class="section section--teal">
    <div class="container-shell">
      <SectionHeading
        eyebrow={t("m428")}
        title={t("m145")}
        copy={t("m146")}
      />
      <ol class="gate-flow">
        <li>
          <Icon name="play" />
          <h3>{t("m147")}</h3>
          <p>{t("m148")}</p>
        </li>
        <li>
          <Icon name="lock" />
          <h3>{t("m149")}</h3>
          <p>{t("m150")}</p>
        </li>
        <li>
          <Icon name="settings" />
          <h3>{t("m151")}</h3>
          <p>{t("m152")}</p>
        </li>
      </ol>
      <p class="small-copy">
        {t("m153")}
      </p>
    </div>
  </section>
  <section id="privacy" class="section">
    <div class="container-shell">
      <div class="split-layout">
        <div>
          <p class="eyebrow">{t("m154")}</p>
          <h2 class="section-title">
            {t("m155")}
            <br />
            <span class="text-teal">{t("m156")}</span>
          </h2>
          <span class="accent-line" aria-hidden="true"></span>
          <p class="section-copy">
            {t("m157")}
          </p>
          <p class="section-copy">
            {t("m158")}
          </p>
          <a class="text-link" href={withBase("privacy/")}>
            {t("m159")} <span aria-hidden="true">→</span>
          </a>
        </div>
        <div class="privacy-visual">
          <Icon name="shield" />
          <h3>{t("m160")}</h3>
          <ul>
            <li>
              <Icon name="check" />
              {t("m161")}
            </li>
            <li>
              <Icon name="check" />
              {t("m421")}
            </li>
            <li>
              <Icon name="check" />
              {t("m163")}
            </li>
            <li>
              <Icon name="check" />
              {t("m164")}
            </li>
          </ul>
        </div>
      </div>
      <div class="shared-play">
        <h3>{t("m165")}</h3>
        <ul>
          <li>
            {t("m166")}
          </li>
          <li>
            {t("m167")}
          </li>
          <li>{t("m168")}</li>
          <li>
            {t("m169")}{" "}
            <a class="text-link" href={withBase("contact/")}>
              {t("m170")}
            </a>{t("m171")}
          </li>
        </ul>
      </div>
    </div>
  </section>
  <FAQ items={parentFaqs} eyebrow={t("m172")} />
  <CallToAction parents />
</BaseLayout>
