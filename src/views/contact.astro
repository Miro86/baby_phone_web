---
import { createTranslator, getLocale, productName } from "../i18n/ui";
import BaseLayout from "../layouts/BaseLayout.astro";
import DodoVisual from "../components/DodoVisual.astro";
import Icon from "../components/Icon.astro";
import { siteConfig } from "../config";
import { localizedPath } from "../utils/urls";
const locale = getLocale(Astro.url);
const t = createTranslator(locale);
const appName = productName(locale);
const withBase = (path = "") => localizedPath(path, locale);
---

<BaseLayout title={t("m229")} description={t("m230")} pageType="ContactPage">
  <section class="section contact-hero">
    <div class="container-shell">
      <nav class="breadcrumbs" aria-label={t("m134")}>
        <a href={withBase()}>{t("m135")}</a>
        <span aria-hidden="true">/</span>
        <span>{t("m231")}</span>
      </nav>
      <div class="split-layout">
        <div>
          <p class="eyebrow">{t("m232")}</p>
          <h1>
            {t("m233")}
            <br />
            <span class="text-teal">{t("m234")}</span>
          </h1>
          <span class="accent-line" aria-hidden="true"></span>
          <p class="hero-intro">{t("m235")}</p>
        </div>
        <DodoVisual bubblePosition="side" message={t("m236")} eager />
      </div>
    </div>
  </section>
  <section class="section">
    <div class="container-shell contact-grid">
      <article class="contact-card">
        <Icon name="email" />
        <h2>{t("m237")}</h2>
        <p>{t("m238")}</p>
        <a
          class="contact-email"
          href={`mailto:${siteConfig.email}?subject=${encodeURIComponent(appName)}`}
        >
          {siteConfig.email}
        </a>
        <dl class="contact-facts">
          <div>
            <dt>{t("m239")}</dt>
            <dd>{siteConfig.brandDisplay}</dd>
          </div>
          <div>
            <dt>{t("m240")}</dt>
            <dd>{t("m442")}</dd>
          </div>
          <div>
            <dt>{t("m443")}</dt>
            <dd>{appName}</dd>
          </div>
          <div>
            <dt>{t("m241")}</dt>
            <dd>{t("m242")}</dd>
          </div>
        </dl>
      </article>
      <aside class="support-guide">
        <h2>{t("m243")}</h2>
        <p>{t("m244")}</p>
        <ol>
          <li>{t("m245")}</li>
          <li>{t("m246")}</li>
          <li>{t("m247")}</li>
        </ol>
        <p class="privacy-note">
          <strong>{t("m248")}</strong> {t("m249")}
        </p>
        <div class="policy-links">
          <a class="text-link" href={withBase("privacy/")}>
            {t("m250")}
          </a>
          <a class="text-link" href={withBase("terms/")}>
            {t("m251")}
          </a>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>
