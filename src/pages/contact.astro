---
import BaseLayout from "../layouts/BaseLayout.astro";
import DodoVisual from "../components/DodoVisual.astro";
import Icon from "../components/Icon.astro";
import { siteConfig } from "../config";
import { withBase } from "../utils/urls";
---

<BaseLayout
  title="Contact & Baby Phone Support"
  description="Contact Mini Dodo Apps for Baby Phone: Animal Sounds support, purchase questions, feedback, and privacy requests. Official email: minidodoapps@gmail.com."
  pageType="ContactPage"
>
  <section class="section contact-hero">
    <div class="container-shell">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a href={withBase()}>Home</a>
        <span aria-hidden="true">/</span>
        <span>Contact</span>
      </nav>
      <div class="split-layout">
        <div>
          <p class="eyebrow">Get in touch</p>
          <h1>
            A little question?
            <br />
            <span class="text-teal">We’re here to help.</span>
          </h1>
          <span class="accent-line" aria-hidden="true"></span>
          <p class="hero-intro">
            Questions about Baby Phone, a purchase, or privacy? An idea you’d
            like to share? Send us an email and tell us what’s on your mind.
          </p>
        </div>
        <DodoVisual message="Say hello!" eager />
      </div>
    </div>
  </section>
  <section class="section section--soft">
    <div class="container-shell contact-grid">
      <article class="contact-card">
        <Icon name="email" />
        <h2>Email Mini Dodo Apps</h2>
        <p>
          Email is our official channel for app support, feedback, and privacy
          questions.
        </p>
        <a
          class="contact-email"
          href={`mailto:${siteConfig.email}?subject=Baby%20Phone%3A%20Animal%20Sounds`}
        >
          {siteConfig.email}
        </a>
        <dl class="contact-facts">
          <div>
            <dt>Developer & contact</dt>
            <dd>{siteConfig.owner}</dd>
          </div>
          <div>
            <dt>Studio</dt>
            <dd>{siteConfig.brand}</dd>
          </div>
          <div>
            <dt>Our app</dt>
            <dd>{siteConfig.name}</dd>
          </div>
          <div>
            <dt>Privacy requests</dt>
            <dd>Use “Privacy request” in the subject</dd>
          </div>
        </dl>
      </article>
      <aside class="support-guide">
        <h2>Help us help you.</h2>
        <p>For a support question, please include:</p>
        <ol>
          <li>Your device model and Android or iOS version.</li>
          <li>What you expected, and what happened instead.</li>
          <li>
            The app version, language, or animal pack involved, if relevant.
          </li>
        </ol>
        <p class="privacy-note">
          <strong>Please protect children’s privacy.</strong> A parent or
          guardian should contact us. Avoid including a child’s full name,
          photo, voice recording, or other unnecessary personal information.
        </p>
        <div class="policy-links">
          <a class="text-link" href={withBase("privacy/")}>
            Privacy policy
          </a>
          <a class="text-link" href={withBase("terms/")}>
            Terms of service
          </a>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>
