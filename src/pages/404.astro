---
import BaseLayout from "../layouts/BaseLayout.astro";
import { withBase } from "../utils/urls";
---

<BaseLayout title="Page not found" description="The requested Baby Phone: Animal Sounds page could not be found." noindex>
  <section class="relative overflow-hidden bg-[linear-gradient(145deg,#e7f5ff,#f5e2f4_55%,#ffe8d9)] py-24 text-center sm:py-32">
    <div class="container-shell">
      <p class="font-[var(--font-display)] text-8xl font-black tracking-[-0.08em] text-[#8cb4d7]">404</p>
      <h1 class="mt-5 font-[var(--font-display)] text-[clamp(2.3rem,6vw,4.5rem)] font-black leading-none tracking-[-0.05em] text-ink">This animal wandered off.</h1>
      <p class="mx-auto mt-5 max-w-xl text-lg leading-8 text-ink-soft">The page is not here, but the rest of the animal friends are waiting back at home.</p>
      <a href={withBase()} class="mt-8 inline-flex min-h-13 items-center rounded-full bg-ink px-7 py-3 text-sm font-black text-white">Return home</a>
    </div>
  </section>
</BaseLayout>
