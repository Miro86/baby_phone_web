---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import SectionHeading from "../components/SectionHeading.astro";
import AppCard from "../components/AppCard.astro";
import ParentPromises from "../components/ParentPromises.astro";
import DodoVisual from "../components/DodoVisual.astro";
import Icon from "../components/Icon.astro";
import smile from "../../assets/brand/smile.png";
import { siteConfig } from "../config";
import { withBase } from "../utils/urls";
import { appSchema } from "../utils/seo";
const schema = appSchema(new URL(withBase(), Astro.site ?? Astro.url.origin));
---

<BaseLayout
  title="Baby Phone Animal Sounds & Playful Kids Apps"
  description={siteConfig.description}
  schema={schema}
>
  <Hero />
  <section id="about" class="section section--navy">
    <div class="container-shell split-layout">
      <div>
        <p class="eyebrow">About Mini Dodo</p>
        <h2 class="section-title">
          Playful apps
          <br />
          with character.
        </h2>
        <p class="section-copy">
          We make room for curiosity, imagination, and those little “again!”
          moments. Our first app, Baby Phone: Animal Sounds, brings animal
          discovery to a familiar pretend phone, with simple play and thoughtful
          choices for grown-ups.
        </p>
        <span class="accent-line" aria-hidden="true"></span>
      </div>
      <div class="about-statement">
        <p class="brand-statement">
          Made <span>with heart.</span>
          <br />
          Made <span>for play.</span>
        </p>
        <Image
          src={smile}
          alt=""
          width={240}
          widths={[180, 240, 480]}
          sizes="(min-width: 2000px) 400px, 200px"
          format="webp"
          loading="lazy"
          class="brand-smile"
        />
      </div>
    </div>
  </section>
  <section id="dodo" class="section section--teal meet-dodo">
    <div class="container-shell split-layout">
      <div>
        <p class="eyebrow">Meet Dodo</p>
        <h2 class="section-title">
          Your cheerful guide
          <br />
          to little adventures.
        </h2>
        <p class="section-copy">
          Say hello to Dodo, the curious little character at the heart of Mini
          Dodo. A friendly face, a big imagination, and always ready for the
          next discovery.
        </p>
        <span class="accent-line" aria-hidden="true"></span>
      </div>
      <DodoVisual />
    </div>
  </section>
  <section id="apps" class="section">
    <div class="container-shell">
      <SectionHeading
        eyebrow="Our app"
        title="Play, discover, and have fun."
        copy="One little phone. A whole world of animal friends. Meet Baby Phone, the first app from Mini Dodo."
      />
      <div id="download">
        <AppCard />
      </div>
    </div>
  </section>
  <section id="parents" class="section section--navy parent-band">
    <div class="container-shell">
      <SectionHeading
        eyebrow="For parents"
        title="Play children enjoy. Choices parents understand."
        copy="Baby Phone keeps animal discovery simple, with clear safeguards around grown-up settings and purchases."
      />
      <ParentPromises />
      <a class="button button--orange" href={withBase("parents/")}>
        Explore the parent guide <Icon name="arrow" />
      </a>
    </div>
  </section>
  <section class="section next-section">
    <div class="container-shell split-layout">
      <div>
        <p class="eyebrow">What’s next?</p>
        <h2 class="section-title">
          Every little adventure starts with curiosity.
        </h2>
        <span class="accent-line" aria-hidden="true"></span>
        <p class="section-copy">
          For now, our world begins with Baby Phone. Have an idea, a favorite
          animal, or a question? We’d love to hear from the grown-ups who
          explore with us.
        </p>
        <a
          class="button button--orange"
          href={withBase("contact/")}
          style="margin-top: 1.5rem"
        >
          Say hello to Mini Dodo <Icon name="arrow" />
        </a>
        <br />
        <a class="text-link" href={withBase("features/#download")}>
          Find Baby Phone on Google Play <span aria-hidden="true">↗</span>
        </a>
      </div>
      <DodoVisual message="Let’s explore together!" />
    </div>
  </section>
</BaseLayout>
