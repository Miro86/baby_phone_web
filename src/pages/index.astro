---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import SectionHeading from "../components/SectionHeading.astro";
import FeatureGrid from "../components/FeatureGrid.astro";
import ScreenshotGallery from "../components/ScreenshotGallery.astro";
import CallToAction from "../components/CallToAction.astro";
import { appFacts, siteConfig } from "../config";
import { withBase } from "../utils/urls";

const faqs = [
  {
    question: "What is Baby Phone: Animal Sounds?",
    answer: "It is a child-friendly mobile app that combines a colorful pretend phone with animal discovery. Children choose or dial an animal, then hear its name and sound.",
  },
  {
    question: "How many animals are included?",
    answer: "The app features 67 animal sounds across five categories. Fifteen farm animals are included, with additional themed animal packs available as optional one-time purchases.",
  },
  {
    question: "Which languages are available?",
    answer: "Animal names are available in English, German, French, Italian, Spanish, Croatian, and Serbian.",
  },
  {
    question: "Does the app contain advertising or subscriptions?",
    answer: "No. The app is ad-free and does not use subscriptions. Optional animal packs are offered as one-time purchases through the relevant app store.",
  },
  {
    question: "How are grown-up controls protected?",
    answer: "A parental gate separates young children from settings and purchase areas intended for adults.",
  },
];

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    name: siteConfig.name,
    description: siteConfig.description,
    applicationCategory: "EducationalApplication",
    operatingSystem: ["iOS", "Android"],
    inLanguage: ["en", "de", "fr", "it", "es", "hr", "sr"],
    featureList: [
      "67 animal sounds",
      "Five animal categories",
      "Animal names in seven languages",
      "No third-party advertising",
      "Parental gate",
      "No subscription",
    ],
    author: {
      "@type": "Person",
      name: siteConfig.owner,
    },
    publisher: {
      "@type": "Organization",
      name: siteConfig.brand,
      email: siteConfig.email,
    },
    audience: {
      "@type": "PeopleAudience",
      audienceType: "Parents, caregivers, and young children",
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqs.map((faq) => ({
      "@type": "Question",
      name: faq.question,
      acceptedAnswer: { "@type": "Answer", text: faq.answer },
    })),
  },
];
---

<BaseLayout title={siteConfig.name} description={siteConfig.description} schema={schema}>
  <Hero />

  <section class="py-16 sm:py-24">
    <div class="container-shell">
      <SectionHeading
        eyebrow="Why families love it"
        title="Playful enough for children. Thoughtful enough for parents."
        copy="Every interaction is designed to feel familiar, rewarding, and easy to understand—without noisy ads or complicated menus getting in the way."
      />
      <div class="mt-12">
        <FeatureGrid />
      </div>
    </div>
  </section>

  <section class="overflow-hidden bg-[#edf7ff] py-16 sm:py-24">
    <div class="container-shell">
      <SectionHeading
        eyebrow="Inside the app"
        title="One little phone. So many friendly voices."
        copy="Take a closer look at the dialer, animal library, pretend calls, language choices, parental gate, and optional animal worlds."
      />
      <div class="mt-12">
        <ScreenshotGallery />
      </div>
      <div class="mt-3 text-center">
        <a href={withBase("features/")} class="inline-flex min-h-12 items-center justify-center rounded-full bg-white px-6 py-3 text-sm font-black text-ink shadow-[0_8px_24px_rgba(47,73,112,0.1)] transition hover:-translate-y-0.5">See every feature <span class="ml-2" aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <section class="py-16 sm:py-24">
    <div class="container-shell grid items-center gap-10 lg:grid-cols-2 lg:gap-16">
      <div>
        <SectionHeading
          align="left"
          eyebrow="Language through play"
          title="Animal names in seven languages"
          copy="Change languages from the grown-up area and turn familiar animals into a gentle first step toward hearing new words."
        />
        <p class="mt-6 rounded-[1.5rem] border border-[#efe8df] bg-white p-5 text-sm leading-7 text-ink-soft shadow-[var(--shadow-card)]">
          The experience is intended for playful exposure and shared discovery. It complements—not replaces—conversation, reading, and language learning with a parent, caregiver, or teacher.
        </p>
      </div>
      <ul class="grid grid-cols-2 gap-3 sm:grid-cols-3" aria-label="Available languages">
        {appFacts.languages.map((language, index) => (
          <li class:list={[
            "flex min-h-28 items-center justify-center rounded-[1.7rem] border border-white p-4 text-center font-[var(--font-display)] text-lg font-black text-ink shadow-[var(--shadow-card)]",
            ["bg-[#dceeff]", "bg-[#ffe5d9]", "bg-[#f2e7ff]", "bg-[#e8f7d7]", "bg-[#fff0c4]", "bg-[#e0f6f3]", "bg-[#ffe1e5]"][index],
          ]}>{language}</li>
        ))}
      </ul>
    </div>
  </section>

  <section class="bg-[#fff0d7] py-16 sm:py-24">
    <div class="container-shell grid items-center gap-12 lg:grid-cols-[0.9fr_1.1fr]">
      <div class="rounded-[2.2rem] border border-white/80 bg-white/70 p-7 shadow-[var(--shadow-soft)] sm:p-10">
        <div class="flex size-14 items-center justify-center rounded-2xl bg-[#e6f6d8] text-2xl text-[#538135]" aria-hidden="true">♙</div>
        <h2 class="mt-6 font-[var(--font-display)] text-3xl font-black leading-tight tracking-[-0.04em] text-ink">A calmer space for curious little hands</h2>
        <p class="mt-4 leading-8 text-ink-soft">The app is presented without third-party advertising. Purchase and settings areas are placed behind a parental gate, and there is no recurring subscription.</p>
        <a href={withBase("parents/")} class="mt-7 inline-flex min-h-12 items-center rounded-full bg-ink px-6 py-3 text-sm font-black text-white">Read the parent guide <span class="ml-2" aria-hidden="true">→</span></a>
      </div>
      <div>
        <p class="eyebrow">Clear answers</p>
        <h2 class="mt-5 font-[var(--font-display)] text-[clamp(2.2rem,4.5vw,4rem)] font-black leading-[1] tracking-[-0.05em] text-ink">Built with grown-ups in mind, too.</h2>
        <dl class="mt-8 grid gap-3">
          <div class="rounded-2xl bg-white/72 p-5"><dt class="font-black text-ink">Advertising</dt><dd class="mt-1 text-sm leading-6 text-ink-soft">No third-party ads inside the app.</dd></div>
          <div class="rounded-2xl bg-white/72 p-5"><dt class="font-black text-ink">Purchases</dt><dd class="mt-1 text-sm leading-6 text-ink-soft">Optional one-time animal packs; no subscription.</dd></div>
          <div class="rounded-2xl bg-white/72 p-5"><dt class="font-black text-ink">Grown-up areas</dt><dd class="mt-1 text-sm leading-6 text-ink-soft">Separated from child-facing play by a parental gate.</dd></div>
        </dl>
      </div>
    </div>
  </section>

  <section class="py-16 sm:py-24">
    <div class="container-shell max-w-4xl">
      <SectionHeading eyebrow="Questions, answered" title="A quick guide for parents and caregivers" />
      <div class="mt-10 grid gap-3">
        {faqs.map((faq, index) => (
          <details class="group rounded-[1.4rem] border border-[#e7eceb] bg-white px-5 py-1 shadow-[0_8px_26px_rgba(47,73,112,0.07)]" open={index === 0}>
            <summary class="flex cursor-pointer list-none items-center justify-between gap-5 py-5 font-black text-ink marker:hidden">
              {faq.question}
              <span class="flex size-8 shrink-0 items-center justify-center rounded-full bg-[#edf5f7] text-lg transition group-open:rotate-45" aria-hidden="true">+</span>
            </summary>
            <p class="max-w-3xl pb-5 pr-8 text-sm leading-7 text-ink-soft">{faq.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <CallToAction />
</BaseLayout>
