---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeading from "../components/SectionHeading.astro";
import ParentPromises from "../components/ParentPromises.astro";
import DodoVisual from "../components/DodoVisual.astro";
import CallToAction from "../components/CallToAction.astro";
import FAQ from "../components/FAQ.astro";
import Icon from "../components/Icon.astro";
import { parentFaqs } from "../data/app";
import { faqSchema } from "../utils/seo";
import { withBase } from "../utils/urls";
const siteUrl = new URL(withBase(), Astro.site ?? Astro.url.origin);
const schema = faqSchema(parentFaqs, new URL("parents/", siteUrl).href);
---

<BaseLayout
  title="For Parents: Baby Phone Privacy & Controls"
  description="A parent’s guide to Baby Phone: Animal Sounds. Learn about ad-free play, the parental gate, child privacy, included animals, and optional one-time purchases."
  schema={schema}
>
  <section class="section parents-hero">
    <div class="container-shell">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a href={withBase()}>Home</a>
        <span aria-hidden="true">/</span>
        <span>For parents</span>
      </nav>
      <div class="split-layout">
        <div>
          <p class="eyebrow">For parents</p>
          <h1>
            Play children enjoy.
            <br />
            <span class="text-teal">Choices parents can understand.</span>
          </h1>
          <span class="accent-line" aria-hidden="true"></span>
          <p class="hero-intro">
            Baby Phone is designed to keep play cheerful and simple, with
            thoughtful safeguards and clear information for the grown-ups who
            choose it.
          </p>
        </div>
        <DodoVisual trust message="Safe play, together!" eager />
      </div>
    </div>
  </section>
  <section id="approach" class="section section--navy">
    <div class="container-shell">
      <SectionHeading
        eyebrow="Our approach"
        title="Thoughtful safeguards in every little discovery."
        copy="Here’s what families can expect from Baby Phone: Animal Sounds."
      />
      <ParentPromises full />
    </div>
  </section>
  <section id="parental-gate" class="section section--teal">
    <div class="container-shell">
      <SectionHeading
        eyebrow="Parental gate"
        title="Grown-up choices stay separate from play."
        copy="Before opening settings or purchase areas, a grown-up completes a simple arithmetic challenge. It helps keep those choices outside the main play experience."
      />
      <ol class="gate-flow">
        <li>
          <Icon name="play" />
          <h3>Play stays simple</h3>
          <p>Children explore the keypad, animal library, and pretend calls.</p>
        </li>
        <li>
          <Icon name="lock" />
          <h3>A grown-up step appears</h3>
          <p>A simple challenge guards access to the adult-facing areas.</p>
        </li>
        <li>
          <Icon name="settings" />
          <h3>Choices stay with adults</h3>
          <p>Settings and optional animal packs are chosen by a grown-up.</p>
        </li>
      </ol>
      <p class="small-copy">
        The parental gate complements your device’s family and purchase approval
        controls. A grown-up should manage app-store purchases and supervise
        play.
      </p>
    </div>
  </section>
  <section id="privacy" class="section">
    <div class="container-shell">
      <div class="split-layout">
        <div>
          <p class="eyebrow">Privacy in plain language</p>
          <h2 class="section-title">
            Less data.
            <br />
            <span class="text-teal">More peace of mind.</span>
          </h2>
          <span class="accent-line" aria-hidden="true"></span>
          <p class="section-copy">
            The child-facing app does not require an account, social profile,
            name, photograph, or voice recording. App preferences stay on the
            device.
          </p>
          <p class="section-copy">
            Google Play handles Android downloads and purchases under its own
            privacy terms. If an adult emails us for support, we receive the
            message and the details they choose to share.
          </p>
          <a class="text-link" href={withBase("privacy/")}>
            Read the full privacy policy <span aria-hidden="true">→</span>
          </a>
        </div>
        <div class="privacy-visual">
          <Icon name="shield" />
          <h3>Privacy in mind.</h3>
          <ul>
            <li>
              <Icon name="check" />
              No child account
            </li>
            <li>
              <Icon name="check" />
              No third-party ads
            </li>
            <li>
              <Icon name="check" />
              Local preferences
            </li>
            <li>
              <Icon name="check" />
              Grown-up controls
            </li>
          </ul>
        </div>
      </div>
      <div class="shared-play">
        <h3>A little shared play goes a long way.</h3>
        <ul>
          <li>
            Choose languages together and repeat favorite animal names out loud.
          </li>
          <li>
            Keep the volume comfortable and balance app time with offline play.
          </li>
          <li>Use your device’s purchase approval and family controls.</li>
          <li>
            A grown-up can{" "}
            <a class="text-link" href={withBase("contact/")}>
              contact us
            </a>{" "}
            if something needs attention.
          </li>
        </ul>
      </div>
    </div>
  </section>
  <FAQ items={parentFaqs} eyebrow="Parent questions" />
  <CallToAction parents />
</BaseLayout>
