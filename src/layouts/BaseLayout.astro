---
import { getImage } from "astro:assets";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";
import socialImage from "../../assets/mini-dodo-social.png";
import brandLogo from "../../assets/brand/logo.png";
import { siteConfig } from "../config";
import { withBase, pageKeyFromUrl, pagePath } from "../utils/urls";
import { siteIdentitySchema } from "../utils/seo";
import {
  createTranslator,
  getLocale,
  languages,
  supportedLocales,
  defaultLocale,
} from "../i18n/ui";
const locale = getLocale(Astro.url);
const t = createTranslator(locale);
const language = languages[locale];
const page = pageKeyFromUrl(Astro.url);

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  schema?: Record<string, unknown> | Record<string, unknown>[];
  pageType?: string;
}
const {
  title,
  description,
  noindex = false,
  schema,
  pageType = "WebPage",
} = Astro.props;
const siteUrl = new URL(
  pagePath("home", locale),
  Astro.site ?? Astro.url.origin,
);
const siteRoot = new URL(withBase(), siteUrl);
const canonical = new URL(pagePath(page, locale), siteUrl);
canonical.search = "";
canonical.hash = "";
const pageTitle =
  page === "home" ? title : `${title} | ${siteConfig.brandDisplay}`;
const social = await getImage({
  src: socialImage,
  width: 1200,
  height: 630,
  fit: "contain",
  format: "jpg",
  quality: 85,
});
const logo = await getImage({
  src: brandLogo,
  width: 512,
  format: "webp",
  quality: 85,
});
const absolute = (path: string) => new URL(path, siteUrl).href;
const additionalSchema = schema
  ? Array.isArray(schema)
    ? schema
    : [schema]
  : [];
const breadcrumbLabel = title.startsWith("Baby Phone") ? "Baby Phone" : title;
const graph = {
  "@context": "https://schema.org",
  "@graph": [
    ...siteIdentitySchema(siteRoot, absolute(logo.src)),
    {
      "@type": pageType,
      "@id": `${canonical.href}#webpage`,
      name: title,
      description,
      url: canonical.href,
      inLanguage: language.htmlLang,
      isPartOf: { "@id": new URL("#website", siteRoot).href },
      publisher: { "@id": new URL("#organization", siteRoot).href },
      ...(canonical.href !== siteUrl.href && !noindex
        ? { breadcrumb: { "@id": `${canonical.href}#breadcrumb` } }
        : {}),
    },
    ...(canonical.href !== siteUrl.href && !noindex
      ? [
          {
            "@type": "BreadcrumbList",
            "@id": `${canonical.href}#breadcrumb`,
            itemListElement: [
              {
                "@type": "ListItem",
                position: 1,
                name: t("m135"),
                item: siteUrl.href,
              },
              {
                "@type": "ListItem",
                position: 2,
                name: breadcrumbLabel,
                item: canonical.href,
              },
            ],
          },
        ]
      : []),
    ...additionalSchema,
  ],
};
---

<!doctype html>
<html lang={language.htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={siteConfig.owner} />
    <meta name="application-name" content={siteConfig.brandDisplay} />
    <meta name="theme-color" content="#103b78" />
    <meta name="color-scheme" content="light" />
    <meta
      name="robots"
      content={
        noindex
          ? "noindex, follow"
          : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
      }
    />
    <link rel="canonical" href={canonical.href} />
    {!noindex && (
      <>
        {supportedLocales.map((candidate) => (
          <link
            rel="alternate"
            hreflang={languages[candidate].htmlLang}
            href={absolute(pagePath(page, candidate))}
          />
        ))}
        <link
          rel="alternate"
          hreflang="x-default"
          href={absolute(pagePath(page, defaultLocale))}
        />
      </>
    )}
    <link
      rel="icon"
      type="image/png"
      sizes="96x96"
      href={withBase("favicon.png")}
    />
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href={withBase("apple-touch-icon.png")}
    />
    <link rel="manifest" href={pagePath("home", locale) + "site.webmanifest"} />
    <link
      rel="sitemap"
      type="application/xml"
      href={withBase("sitemap-index.xml")}
    />
    <link
      rel="preload"
      href={withBase("fonts/nunito-latin.woff2")}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <style
      is:inline
      set:html={`@font-face { font-family: "Nunito"; src: url("${withBase("fonts/nunito-latin.woff2")}") format("woff2"); font-style: normal; font-weight: 400 900; font-display: swap; unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD; }
@font-face { font-family: "Nunito"; src: url("${withBase("fonts/nunito-latin-ext.woff2")}") format("woff2"); font-style: normal; font-weight: 400 900; font-display: swap; unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C4, U+2113, U+2C60-2C7F, U+A720-A7FF; }
@font-face { font-family: "Nunito"; src: url("${withBase("fonts/nunito-cyrillic.woff2")}") format("woff2"); font-style: normal; font-weight: 400 900; font-display: swap; unicode-range: U+0400-045F, U+0490-0491, U+04B0-04B1, U+2116; }`}
    ></style>
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteConfig.brandDisplay} />
    <meta property="og:locale" content={language.ogLocale} />
    {supportedLocales
      .filter((candidate) => candidate !== locale)
      .map((candidate) => (
        <meta
          property="og:locale:alternate"
          content={languages[candidate].ogLocale}
        />
      ))}
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={absolute(social.src)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t("m394")} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absolute(social.src)} />
    <meta name="twitter:image:alt" content={t("m395")} />
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(graph).replace(/</g, "\\u003c")}
    ></script>
  </head>
  <body>
    <a href="#main-content" class="skip-link">
      {t("m393")}
    </a>
    <Header />
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
