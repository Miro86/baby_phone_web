---
import { createTranslator, getLocale, legalDate } from "../i18n/ui";
import BaseLayout from "./BaseLayout.astro";
import { siteConfig } from "../config";
import { localizedPath } from "../utils/urls";
const locale = getLocale(Astro.url);
const t = createTranslator(locale);
const withBase = (path = "") => localizedPath(path, locale);
interface Props {
  title: string;
  description: string;
  eyebrow: string;
  showDate?: boolean;
}
const { title, description, eyebrow, showDate = true } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <section class="section legal-hero">
    <div class="container-shell">
      <nav class="breadcrumbs" aria-label={t("m134")}>
        <a href={withBase()}>{t("m135")}</a>
        <span aria-hidden="true">/</span>
        <span>{title}</span>
      </nav>
      <p class="eyebrow">{eyebrow}</p>
      <h1>{title}</h1>
      <span class="accent-line" aria-hidden="true"></span>
      <p class="hero-intro">{description}</p>
      {showDate && <p class="legal-date">
        {t("m259")} {legalDate(locale)}
      </p>}
    </div>
  </section>
  <section class="section legal-section">
    <div class="container-shell legal-layout">
      <aside class="legal-sidebar">
        <h2>{t("m260")}</h2>
        <nav aria-label={t("m261")}>
          <a
            href={withBase("privacy/")}
            aria-current={title === t("m039") ? "page" : undefined}
          >
            {t("m250")}
          </a>
          <a
            href={withBase("terms/")}
            aria-current={title === t("m001") ? "page" : undefined}
          >
            {t("m251")}
          </a>
          <a href={withBase("parents/")}>{t("m136")}</a>
          <a href={withBase("contact/")}>{t("m262")}</a>
        </nav>
        <p>
          {t("m263")}
          <br />
          <a href={`mailto:${siteConfig.email}`}>{t("m264")}</a>
        </p>
      </aside>
      <article class="legal-copy">
        <slot />
      </article>
    </div>
  </section>
</BaseLayout>
