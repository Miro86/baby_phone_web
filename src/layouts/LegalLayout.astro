---
import BaseLayout from "./BaseLayout.astro";
import { siteConfig } from "../config";
import { withBase } from "../utils/urls";
interface Props {
  title: string;
  description: string;
  eyebrow: string;
}
const { title, description, eyebrow } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <section class="section legal-hero">
    <div class="container-shell">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a href={withBase()}>Home</a>
        <span aria-hidden="true">/</span>
        <span>{title}</span>
      </nav>
      <p class="eyebrow">{eyebrow}</p>
      <h1>{title}</h1>
      <span class="accent-line" aria-hidden="true"></span>
      <p class="hero-intro">{description}</p>
      <p class="legal-date">
        Effective and last updated: {siteConfig.lastUpdated}
      </p>
    </div>
  </section>
  <section class="section legal-section">
    <div class="container-shell legal-layout">
      <aside class="legal-sidebar">
        <h2>Helpful links</h2>
        <nav aria-label="Policy navigation">
          <a
            href={withBase("privacy/")}
            aria-current={title === "Privacy Policy" ? "page" : undefined}
          >
            Privacy policy
          </a>
          <a
            href={withBase("terms/")}
            aria-current={title === "Terms of Service" ? "page" : undefined}
          >
            Terms of service
          </a>
          <a href={withBase("parents/")}>For parents</a>
          <a href={withBase("contact/")}>Contact & support</a>
        </nav>
        <p>
          Questions about a policy?
          <br />
          <a href={`mailto:${siteConfig.email}`}>Email Mini Dodo</a>
        </p>
      </aside>
      <article class="legal-copy">
        <slot />
      </article>
    </div>
  </section>
</BaseLayout>
