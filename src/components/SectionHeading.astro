---
interface Props {
  eyebrow: string;
  title: string;
  copy?: string;
  align?: "left" | "center";
}
const { eyebrow, title, copy, align = "left" } = Astro.props;
---

<div
  class:list={[
    "section-heading",
    { "section-heading--center": align === "center" },
  ]}
>
  <p class="eyebrow">{eyebrow}</p>
  <h2 class="section-title">{title}</h2>
  {copy && <p class="section-copy">{copy}</p>}
  <span class="accent-line" aria-hidden="true"></span>
</div>
