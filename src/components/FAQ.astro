---
import { createTranslator, getLocale } from "../i18n/ui";
import type { FAQ } from "../data/app";
const locale = getLocale(Astro.url);
const t = createTranslator(locale);
interface Props {
  items: FAQ[];
  title?: string;
  eyebrow?: string;
  id?: string;
}
const {
  items,
  title = t("m363"),
  eyebrow = t("m364"),
  id = "faq",
} = Astro.props;
---

<section id={id} class="section section--teal">
  <div class="container-shell faq-shell">
    <p class="eyebrow">{eyebrow}</p>
    <h2 class="section-title">{title}</h2>
    <span class="accent-line" aria-hidden="true"></span>
    <div class="faq-list">
      {items.map((item, index) => (
        <details class="faq-item" open={index === 0}>
          <summary>
            {item.question}
            <span class="faq-plus" aria-hidden="true">
              +
            </span>
          </summary>
          <p>{item.answer}</p>
        </details>
      ))}
    </div>
  </div>
</section>
