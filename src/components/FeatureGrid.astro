---
import Icon from "./Icon.astro";
const features = [
  {
    icon: "phone",
    title: "A little phone, just for play",
    copy: "Tap the colorful keypad or choose a friend from the animal library. Every call is pretend.",
  },
  {
    icon: "sound",
    title: "67 animal sounds",
    copy: "Hear familiar farm friends and discover animal voices across five themed categories.",
  },
  {
    icon: "globe",
    title: "Names in seven languages",
    copy: "Listen to animal names in English, German, French, Italian, Spanish, Croatian, and Serbian.",
  },
];
---

<div class="feature-grid">
  {features.map((feature) => (
    <article>
      <Icon name={feature.icon} />
      <h3>{feature.title}</h3>
      <p>{feature.copy}</p>
    </article>
  ))}
</div>
