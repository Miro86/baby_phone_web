---
import { createTranslator, getLocale } from "../i18n/ui";
import Icon from "./Icon.astro";
const locale = getLocale(Astro.url);
const t = createTranslator(locale);
const features = [
  {
    icon: "phone",
    title: t("m357"),
    copy: t("m358"),
  },
  {
    icon: "sound",
    title: t("m359"),
    copy: t("m360"),
  },
  {
    icon: "globe",
    title: t("m361"),
    copy: t("m362"),
  },
];
---

<div class="feature-grid">
  {features.map((feature) => (
    <article>
      <Icon name={feature.icon} />
      <h3>{feature.title}</h3>
      <p>{feature.copy}</p>
    </article>
  ))}
</div>
