---
import { defaultLocale, supportedLocales } from "../i18n/ui";
import { pagePath, type PageKey } from "../utils/urls";
interface Props { page: PageKey }
const { page } = Astro.props;
const target = pagePath(page, defaultLocale);
const canonical = new URL(target, Astro.site ?? Astro.url.origin).href;
const destinations = Object.fromEntries(supportedLocales.map((locale) => [locale, pagePath(page, locale)]));
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Mini Dodo</title>
    <meta name="robots" content="noindex, follow" />
    <link rel="canonical" href={canonical} />
    <script is:inline define:vars={{ destinations, target }}>
      let destination = target;
      try {
        const stored = localStorage.getItem("mini-dodo-language");
        if (stored && Object.prototype.hasOwnProperty.call(destinations, stored)) destination = destinations[stored];
      } catch { /* German remains the default when storage is unavailable. */ }
      location.replace(destination + location.search + location.hash);
    </script>
    <noscript><meta http-equiv="refresh" content={`0;url=${target}`} /></noscript>
  </head>
  <body><a href={target} lang="de">Weiter zu Mini Dodo</a></body>
</html>
