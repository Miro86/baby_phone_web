---
import { createTranslator, getLocale } from "../i18n/ui";
import DodoVisual from "./DodoVisual.astro";
import StoreLinks from "./StoreLinks.astro";
import { localizedPath } from "../utils/urls";
const locale = getLocale(Astro.url);
const t = createTranslator(locale);
const withBase = (path = "") => localizedPath(path, locale);
interface Props {
  parents?: boolean;
}
const { parents = false } = Astro.props;
---

<section id="download" class="section cta-section">
  <div class="container-shell split-layout">
    <div>
      <p class="eyebrow">
        {parents ? t("m371") : t("m372")}
      </p>
      <h2 class="section-title">
        {parents
          ? t("m373")
          : t("m374")}
      </h2>
      <span class="accent-line" aria-hidden="true"></span>
      <p class="section-copy">
        {parents ? t("m375") : t("m436")}
      </p>
      <StoreLinks />
      <a class="text-link" href={withBase("contact/")}>
        {t("m376")} <span aria-hidden="true">↗</span>
      </a>
    </div>
    <DodoVisual bubblePosition="side" message={parents ? t("m196") : t("m418")} />
  </div>
</section>
