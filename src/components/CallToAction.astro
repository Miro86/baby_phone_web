---
import DodoVisual from "./DodoVisual.astro";
import StoreLinks from "./StoreLinks.astro";
import { withBase } from "../utils/urls";
interface Props {
  parents?: boolean;
}
const { parents = false } = Astro.props;
---

<section id="download" class="section cta-section">
  <div class="container-shell split-layout">
    <div>
      <p class="eyebrow">
        {parents ? "A little discovery, together" : "Ready to play?"}
      </p>
      <h2 class="section-title">
        {parents
          ? "Find a new favorite sound."
          : "Meet your new animal friends."}
      </h2>
      <span class="accent-line" aria-hidden="true"></span>
      <p class="section-copy">
        Start with 15 farm animals, explore their sounds, and share a little
        moment of discovery. Baby Phone is available for Android. iOS is coming
        soon.
      </p>
      <StoreLinks />
      <a class="text-link" href={withBase("contact/")}>
        Have a question? Say hello <span aria-hidden="true">↗</span>
      </a>
    </div>
    <DodoVisual message={parents ? "Let’s explore together!" : "Let’s play!"} />
  </div>
</section>
