---
import { siteConfig } from "../config";
interface Props {
  compact?: boolean;
}
const { compact = false } = Astro.props;
---

<div class:list={["store-links", { "store-links--compact": compact }]}>
  <a
    class="store-button store-button--google"
    href={siteConfig.googlePlayUrl}
    rel="external"
  >
    <svg
      aria-hidden="true"
      viewBox="0 0 24 26"
      width="24"
      height="26"
      fill="currentColor"
    >
      <path d="M2 2v22l12-11L2 2Zm2-2 12 11 4-4L4 0Zm12 15L4 26l16-7-4-4Zm2-2 4 4c3-2 3-6 0-8l-4 4Z" />
    </svg>
    <span>
      <small>Get it on</small>
      <strong>Google Play</strong>
    </span>
  </a>
  {siteConfig.appStoreUrl ? (
    <a class="store-button" href={siteConfig.appStoreUrl} rel="external">
      <span>
        <small>Download on the</small>
        <strong>App Store</strong>
      </span>
    </a>
  ) : (
    <span class="store-button store-button--soon">
      <svg
        aria-hidden="true"
        width="24"
        height="26"
        viewBox="0 0 24 26"
        fill="currentColor"
      >
        <path d="M17 0c0 3-2 5-5 5 0-3 2-5 5-5Zm3 19c-1 3-3 6-5 6-1 0-2-1-3-1s-3 1-4 1c-3-1-6-6-6-11 0-5 3-8 6-8 2 0 3 1 4 1s3-1 5-1c2 0 4 1 5 3-5 3-4 8 0 10Z" />
      </svg>
      <span>
        <small>Coming soon to the</small>
        <strong>App Store</strong>
      </span>
    </span>
  )}
</div>
