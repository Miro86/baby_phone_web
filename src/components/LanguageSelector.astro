---
import { createTranslator, getLocale, languageNames, languages, supportedLocales } from "../i18n/ui";
import { pageKeyFromUrl, pagePath } from "../utils/urls";
const locale = getLocale(Astro.url);
const t = createTranslator(locale);
const labels = languageNames[locale];
const page = pageKeyFromUrl(Astro.url);
---
<details class="language-selector">
  <summary aria-label={`${t("m390")}: ${labels[locale]}`}>
    <span>{locale.toUpperCase()}</span>
    <svg aria-hidden="true" viewBox="0 0 16 16" width="12" height="12" fill="none" stroke="currentColor" stroke-width="1.5"><path d="m3 6 5 5 5-5" /></svg>
  </summary>
  <nav class="language-options" aria-label={t("m391")}>
    {supportedLocales.map((candidate) => (
      <a href={pagePath(page, candidate)} lang={languages[locale].htmlLang} hreflang={languages[candidate].htmlLang} data-language-link={candidate} aria-current={candidate === locale ? "page" : undefined}>
        <span>{labels[candidate]}</span>
        {candidate === locale && <span aria-hidden="true">✓</span>}
      </a>
    ))}
  </nav>
</details>
<script>
  const selector = document.querySelector<HTMLDetailsElement>(".language-selector");
  const trigger = selector?.querySelector<HTMLElement>("summary");
  const choices = Array.from(selector?.querySelectorAll<HTMLAnchorElement>("[data-language-link]") ?? []);
  selector?.addEventListener("toggle", () => {
    if (selector.open) {
      const mobile = document.querySelector<HTMLDetailsElement>(".mobile-menu");
      if (mobile) mobile.open = false;
    }
  });
  selector?.addEventListener("keydown", (event) => {
    if (["ArrowDown", "ArrowUp", "Home", "End"].includes(event.key)) {
      event.preventDefault();
      selector.open = true;
      const current = choices.indexOf(document.activeElement as HTMLAnchorElement);
      const next = event.key === "Home" ? 0 : event.key === "End" ? choices.length - 1 : event.key === "ArrowDown" ? (current + 1) % choices.length : (current < 0 ? choices.length - 1 : (current - 1 + choices.length) % choices.length);
      choices[next]?.focus();
    }
    if (event.key === "Escape" && selector.open) {
      event.preventDefault();
      selector.open = false;
      trigger?.focus();
    }
  });
  document.addEventListener("click", (event) => {
    if (event.target instanceof Node && selector && !selector.contains(event.target)) selector.open = false;
  });
  choices.forEach((link) => {
    link.hash = location.hash;
    link.addEventListener("click", () => {
      try { localStorage.setItem("mini-dodo-language", link.dataset.languageLink!); } catch { /* Links still work without storage. */ }
    });
  });
</script>
