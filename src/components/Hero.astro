---
import { Picture } from "astro:assets";
import logo from "../../assets/brand/logo.png";
import Icon from "./Icon.astro";
import { withBase } from "../utils/urls";
---

<section class="section home-hero">
  <div class="container-shell split-layout">
    <div class="hero-copy">
      <p class="eyebrow">Welcome to Mini Dodo</p>
      <h1>
        Small apps.
        <br />
        <span class="text-teal">Big adventures.</span>
      </h1>
      <p class="hero-intro">
        Playful discovery for curious little minds. Meet Baby Phone: Animal
        Sounds, our ad-free pretend phone app for young children.
      </p>
      <a class="button button--orange" href={withBase("features/")}>
        Explore Baby Phone <Icon name="arrow" />
      </a>
      <p class="hero-note">
        <span aria-hidden="true" class="status-dot"></span>Available on Android
        · iOS coming soon
      </p>
    </div>
    <Picture
      src={logo}
      alt="Mini Dodo — a cheerful turquoise Dodo with the colorful Mini Dodo wordmark"
      width={600}
      widths={[280, 400, 560, 760, 960, 1178]}
      sizes="(min-width: 2000px) 1200px, (min-width: 900px) 40vw, (min-width: 600px) 360px, 75vw"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={65}
      loading="eager"
      fetchpriority="high"
      class="hero-logo"
      pictureAttributes={{ class: "hero-picture" }}
    />
  </div>
</section>
