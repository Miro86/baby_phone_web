---
import { createTranslator, getLocale } from "../i18n/ui";
import { Image, getImage } from "astro:assets";
import appIcon from "../../assets/app-icon.png";
import banner from "../../assets/promo-banner.png";
import StoreLinks from "./StoreLinks.astro";
import Icon from "./Icon.astro";
import { localizedPath } from "../utils/urls";
const locale = getLocale(Astro.url);
const t = createTranslator(locale);
const withBase = (path = "") => localizedPath(path, locale);
const appBanner = await getImage({
  src: banner,
  alt: t("m385"),
  width: 1024,
  widths: [360, 560, 680, 800, 1024, 1280, 1536],
  format: "webp",
  quality: 75,
  loading: "lazy",
});
---

<article class="app-card">
  <div class="app-card-copy">
    <div class="app-card-heading">
      <Image
        src={appIcon}
        alt={t("m378")}
        width={112}
        widths={[84, 112, 168, 224]}
        sizes="(min-width: 2000px) 200px, 112px"
        format="webp"
        loading="lazy"
      />
      <div>
        <p class="eyebrow">{t("m379")}</p>
        <h3>
          Baby Phone:
          <br />
          {t("m202")}
        </h3>
      </div>
    </div>
    <p>
      {t("m380")}
    </p>
    <ul class="pill-list" aria-label={t("m381")}>
      <li>{t("m359")}</li>
      <li>{t("m382")}</li>
      <li>{t("m162")}</li>
    </ul>
    <a class="button button--orange" href={withBase("features/")}>
      {t("m383")} <Icon name="arrow" />
    </a>
    <StoreLinks compact />
  </div>
  <a
    href={withBase("features/")}
    class="app-card-banner"
    aria-label={t("m384")}
  >
    <picture>
      <source
        media="(width > 600px)"
        type="image/webp"
        srcset={appBanner.srcSet.attribute}
        sizes="(min-width: 2000px) 1400px, (min-width: 800px) 42vw, calc(100vw - 80px)"
      />
      <img
        {...appBanner.attributes}
        src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7"
      />
    </picture>
  </a>
</article>
