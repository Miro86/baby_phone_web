---
import { createTranslator, getLocale } from "../i18n/ui";
import { Image, getImage } from "astro:assets";
import appIcon from "../../assets/app-icon.png";
import { babyPhoneCovers } from "../data/baby-phone-covers";
import StoreLinks from "./StoreLinks.astro";
import Icon from "./Icon.astro";
import { localizedPath } from "../utils/urls";
const locale = getLocale(Astro.url);
const t = createTranslator(locale);
const withBase = (path = "") => localizedPath(path, locale);
const bannerWidths = [280, 320, 360, 480, 560, 592, 680, 720, 800, 1024, 1280, 1536];
// Match the card's padding, column ratio and large-screen root-font scaling.
const bannerSizes = "(min-width: 5000px) 1428px, (min-width: 2000px) 28.56vw, (min-width: 1051px) calc((min(74rem, 100vw - clamp(2rem, 6vw, 4rem)) - 6rem) * 0.525), (min-width: 801px) calc((100vw - clamp(2rem, 6vw, 4rem) - 4.5rem) / 2), (max-width: 350px) calc(100vw - 3.7rem), calc(100vw - clamp(2rem, 6vw, 4rem) - 3rem)";
const appAvifBanner = await getImage({
  src: babyPhoneCovers[locale],
  width: 1024,
  widths: bannerWidths,
  format: "avif",
  quality: 50,
});
const appBanner = await getImage({
  src: babyPhoneCovers[locale],
  alt: t("m385"),
  width: 1024,
  widths: bannerWidths,
  format: "webp",
  quality: 65,
  loading: "lazy",
});
---

<article class="app-card">
  <div class="app-card-copy">
    <div class="app-card-heading">
      <Image
        src={appIcon}
        alt={t("m378")}
        width={112}
        widths={[84, 112, 168, 224]}
        sizes="(min-width: 2000px) 200px, 112px"
        format="webp"
        loading="lazy"
      />
      <div>
        <p class="eyebrow">{t("m379")}</p>
        <h3>
          Baby Phone:
          <br />
          {t("m202")}
        </h3>
      </div>
    </div>
    <p>
      {t("m380")}
    </p>
    <ul class="pill-list" aria-label={t("m381")}>
      <li>{t("m359")}</li>
      <li>{t("m382")}</li>
      <li>{t("m162")}</li>
    </ul>
    <a class="button button--orange" href={withBase("features/")}>
      {t("m383")} <Icon name="arrow" />
    </a>
    <StoreLinks compact />
  </div>
  <a
    href={withBase("features/")}
    class="app-card-banner"
    aria-label={t("m384")}
  >
    <picture>
      <source
        media="(max-width: 600px)"
        srcset="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7"
      />
      <source
        type="image/avif"
        srcset={appAvifBanner.srcSet.attribute}
        sizes={bannerSizes}
      />
      <source
        type="image/webp"
        srcset={appBanner.srcSet.attribute}
        sizes={bannerSizes}
      />
      <img
        {...appBanner.attributes}
        src={appBanner.src}
        srcset={appBanner.srcSet.attribute}
        sizes={bannerSizes}
      />
    </picture>
  </a>
</article>
