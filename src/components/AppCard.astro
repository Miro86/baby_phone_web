---
import { Image } from "astro:assets";
import appIcon from "../../assets/app-icon.png";
import banner from "../../assets/promo-banner.png";
import StoreLinks from "./StoreLinks.astro";
import Icon from "./Icon.astro";
import { withBase } from "../utils/urls";
---

<article class="app-card">
  <div class="app-card-copy">
    <div class="app-card-heading">
      <Image
        src={appIcon}
        alt="Baby Phone app icon: a yellow chick holding a toy phone"
        width={112}
        widths={[84, 112, 168, 224]}
        sizes="(min-width: 2000px) 200px, 112px"
        format="webp"
        loading="lazy"
      />
      <div>
        <p class="eyebrow">Meet our first app</p>
        <h3>
          Baby Phone:
          <br />
          Animal Sounds
        </h3>
      </div>
    </div>
    <p>
      Call cute animals, hear their names and sounds, and discover a cheerful
      world of pretend play.
    </p>
    <ul class="pill-list" aria-label="Baby Phone highlights">
      <li>67 animal sounds</li>
      <li>7 languages</li>
      <li>No third-party ads</li>
    </ul>
    <a class="button button--orange" href={withBase("features/")}>
      Discover Baby Phone <Icon name="arrow" />
    </a>
    <StoreLinks compact />
  </div>
  <a
    href={withBase("features/")}
    class="app-card-banner"
    aria-label="Explore Baby Phone: Animal Sounds"
  >
    <Image
      src={banner}
      alt="Baby Phone: Animal Sounds characters in a colorful countryside — 67 sounds and five categories"
      width={1024}
      widths={[360, 560, 680, 800, 1024, 1280, 1536]}
      sizes="(min-width: 2000px) 1400px, (min-width: 800px) 42vw, calc(100vw - 80px)"
      format="webp"
      quality={75}
      loading="lazy"
    />
  </a>
</article>
