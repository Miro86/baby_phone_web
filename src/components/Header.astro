---
import AppMark from "./AppMark.astro";
import { ui } from "../i18n/ui";
import { withBase } from "../utils/urls";

const labels = ui.en.nav;
const currentPath = Astro.url.pathname;
const navigation = [
  { label: labels.home, href: withBase() },
  { label: labels.features, href: withBase("features/") },
  { label: labels.parents, href: withBase("parents/") },
  { label: labels.contact, href: withBase("contact/") },
];
---

<header class="sticky top-0 z-50 border-b border-white/60 bg-cream/88 backdrop-blur-xl">
  <div class="container-shell flex h-[4.8rem] items-center justify-between gap-5">
    <AppMark compact />

    <nav class="hidden items-center gap-1 md:flex" aria-label="Primary navigation">
      {navigation.map((item) => (
        <a
          href={item.href}
          aria-current={currentPath === item.href ? "page" : undefined}
          class:list={[
            "rounded-full px-4 py-2.5 text-sm font-extrabold transition",
            currentPath === item.href
              ? "bg-white text-ink shadow-[0_6px_22px_rgba(47,73,112,0.09)]"
              : "text-ink-soft hover:bg-white/70 hover:text-ink",
          ]}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <details class="relative block shrink-0 md:hidden">
      <summary class="flex size-11 cursor-pointer list-none items-center justify-center rounded-full bg-white shadow-[0_6px_20px_rgba(47,73,112,0.1)] marker:hidden" aria-label="Open navigation menu">
        <svg aria-hidden="true" viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round">
          <path d="M4 7h16M4 12h16M4 17h16"></path>
        </svg>
      </summary>
      <nav class="absolute right-0 top-14 grid min-w-52 gap-1 rounded-[1.4rem] border border-white bg-white p-2.5 shadow-[0_20px_60px_rgba(47,73,112,0.18)]" aria-label="Mobile navigation">
        {navigation.map((item) => (
          <a href={item.href} class="rounded-2xl px-4 py-3 text-sm font-extrabold text-ink-soft hover:bg-cream hover:text-ink">
            {item.label}
          </a>
        ))}
      </nav>
    </details>
  </div>
</header>
