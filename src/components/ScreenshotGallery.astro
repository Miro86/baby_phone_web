---
import { Image } from "astro:assets";
import dialer from "../../assets/screenshot-animal-dialer.png";
import dogCall from "../../assets/screenshot-dog-call.png";
import library from "../../assets/screenshot-animal-library.png";
import languages from "../../assets/screenshot-seven-languages.png";
import goatCall from "../../assets/screenshot-goat-call.png";
import parentGate from "../../assets/screenshot-parental-gate.png";
import packs from "../../assets/screenshot-animal-packs.png";
import catCall from "../../assets/screenshot-cat-call.png";
const screenshots = [
  {
    src: dialer,
    title: "Dial an animal",
    copy: "Big, colorful buttons make pretend phone play easy to explore.",
    alt: "Baby Phone’s colorful pretend phone keypad with numbers and animal buttons",
  },
  {
    src: library,
    title: "Choose an animal friend",
    copy: "Browse the animal library and find a familiar face.",
    alt: "Baby Phone farm animal library showing dog, cat, cow, pig, sheep, horse, and other animals",
  },
  {
    src: dogCall,
    title: "Listen, learn, and smile",
    copy: "Hear your animal friend’s name and sound during a pretend call.",
    alt: "Friendly dog character answering a pretend call in Baby Phone",
  },
  {
    src: languages,
    title: "Seven ways to say hello",
    copy: "A grown-up can choose the languages for animal names.",
    alt: "Animal name language settings: English, German, French, Italian, Spanish, Croatian, and Serbian",
  },
  {
    src: catCall,
    title: "A cheerful cat call",
    copy: "Meet more animal characters and discover their voices.",
    alt: "An orange cat character on Baby Phone’s pretend animal call screen",
  },
  {
    src: goatCall,
    title: "Another farm friend",
    copy: "Repeat favorite sounds and make discoveries together.",
    alt: "A goat character answering a simulated phone call on the farm",
  },
  {
    src: parentGate,
    title: "Choices for grown-ups",
    copy: "An arithmetic challenge guards settings and purchases.",
    alt: "Baby Phone parental gate asking a simple arithmetic question",
  },
  {
    src: packs,
    title: "More worlds to explore",
    copy: "Optional one-time animal packs, chosen by a grown-up.",
    alt: "Baby Phone’s optional animal packs for safari, forest, water, polar, and exotic animals",
  },
];
---

<div class="screenshot-gallery">
  <div class="gallery-header">
    <div class="section-heading">
      <p class="eyebrow">Preview the experience</p>
      <h2 class="section-title">
        Discover a world
        <br />
        of animal sounds.
      </h2>
      <span class="accent-line" aria-hidden="true"></span>
    </div>
    <div class="gallery-controls" hidden>
      <button
        type="button"
        data-gallery-prev
        aria-label="Previous app screenshots"
        aria-controls="app-screenshots"
        disabled
      >
        <span aria-hidden="true">←</span>
      </button>
      <button
        type="button"
        data-gallery-next
        aria-label="Next app screenshots"
        aria-controls="app-screenshots"
      >
        <span aria-hidden="true">→</span>
      </button>
    </div>
  </div>
  <div
    id="app-screenshots"
    class="screenshot-track"
    tabindex="0"
    role="region"
    aria-label="Baby Phone app screenshots; scroll horizontally to explore"
  >
    {screenshots.map((screenshot) => (
      <figure class="screenshot-card">
        <div class="screenshot-image">
          <Image
            src={screenshot.src}
            alt={screenshot.alt}
            width={360}
            widths={[240, 360, 480, 720]}
            sizes="(min-width: 2000px) 600px, (min-width: 600px) 240px, 65vw"
            format="webp"
            quality={78}
            loading="lazy"
          />
        </div>
        <figcaption>
          <h3>{screenshot.title}</h3>
          <p>{screenshot.copy}</p>
        </figcaption>
      </figure>
    ))}
  </div>
  <p class="gallery-hint">
    Swipe, scroll, or use the arrow buttons to explore real app screens.
  </p>
</div>
<script>
  const gallery = document.querySelector<HTMLElement>(".screenshot-gallery");
  const track = gallery?.querySelector<HTMLElement>(".screenshot-track");
  const prev = gallery?.querySelector<HTMLButtonElement>("[data-gallery-prev]");
  const next = gallery?.querySelector<HTMLButtonElement>("[data-gallery-next]");
  if (track && prev && next) {
    gallery
      ?.querySelector<HTMLElement>(".gallery-controls")
      ?.removeAttribute("hidden");
    const update = () => {
      prev.disabled = track.scrollLeft < 2;
      next.disabled =
        track.scrollLeft + track.clientWidth >= track.scrollWidth - 2;
    };
    const move = (direction: number) =>
      track.scrollBy({
        left: direction * track.clientWidth,
        behavior: matchMedia("(prefers-reduced-motion: reduce)").matches
          ? "instant"
          : "smooth",
      });
    prev.addEventListener("click", () => move(-1));
    next.addEventListener("click", () => move(1));
    track.addEventListener("scroll", update, { passive: true });
    new ResizeObserver(update).observe(track);
    update();
  }
</script>
