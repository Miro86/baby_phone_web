---
import { Image } from "astro:assets";
import appIcon from "../../assets/app-icon.png";
import { siteConfig } from "../config";
import { withBase } from "../utils/urls";

interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
---

<a class="group inline-flex items-center gap-3" href={withBase()} aria-label={`${siteConfig.name} home`}>
  <Image
    src={appIcon}
    alt=""
    width={compact ? 42 : 50}
    height={compact ? 42 : 50}
    format="webp"
    class:list={[
      "rounded-[28%] shadow-[0_8px_22px_rgba(51,73,107,0.18)] transition-transform duration-300 group-hover:-rotate-3 group-hover:scale-105",
      compact ? "size-10" : "size-11 sm:size-12",
    ]}
  />
  <span class="leading-none">
    <span class="block font-[var(--font-display)] text-[0.98rem] font-black tracking-[-0.025em] text-ink sm:text-[1.08rem]">Baby Phone</span>
    <span class="mt-1 block text-[0.66rem] font-extrabold uppercase tracking-[0.16em] text-sky-deep">Animal Sounds</span>
  </span>
</a>
