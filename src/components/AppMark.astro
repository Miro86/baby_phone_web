---
import { createTranslator, getLocale } from "../i18n/ui";
import { Image } from "astro:assets";
import wordmark from "../../assets/brand/wordmark.png";
import { localizedPath } from "../utils/urls";
const locale = getLocale(Astro.url);
const t = createTranslator(locale);
const withBase = (path = "") => localizedPath(path, locale);
interface Props {
  compact?: boolean;
}
const { compact = false } = Astro.props;
---

<a
  href={withBase()}
  class:list={["brand-mark", { "brand-mark--compact": compact }]}
  aria-label={t("m377")}
>
  <Image
    src={wordmark}
    alt="Mini Dodo"
    width={160}
    widths={[120, 160, 210, 240, 320, 480, 680]}
    sizes={
      compact
        ? "(min-width: 2000px) 300px, 120px"
        : "(min-width: 2000px) 340px, 136px"
    }
    format="webp"
    quality={75}
    loading={compact ? "eager" : "lazy"}
  />
</a>
