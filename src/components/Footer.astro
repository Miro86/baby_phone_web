---
import AppMark from "./AppMark.astro";
import { siteConfig } from "../config";
import { withBase } from "../utils/urls";

const year = new Date().getFullYear();
---

<footer class="border-t border-[#dfe8e7] bg-white/70 py-12">
  <div class="container-shell grid gap-10 md:grid-cols-[1.2fr_0.8fr_0.8fr]">
    <div>
      <AppMark />
      <p class="mt-5 max-w-sm text-sm leading-7 text-ink-soft">
        A gentle animal-sound learning app made for little explorers and their grown-ups.
      </p>
      <p class="mt-4 text-xs font-bold uppercase tracking-[0.13em] text-[#7c899c]">Made by {siteConfig.brand}</p>
    </div>

    <div>
      <h2 class="text-sm font-black uppercase tracking-[0.14em] text-ink">Explore</h2>
      <nav class="mt-4 grid gap-3 text-sm font-bold text-ink-soft" aria-label="Footer product navigation">
        <a class="hover:text-sky-deep" href={withBase("features/")}>Features</a>
        <a class="hover:text-sky-deep" href={withBase("parents/")}>For parents</a>
        <a class="hover:text-sky-deep" href={withBase("contact/")}>Contact</a>
      </nav>
    </div>

    <div>
      <h2 class="text-sm font-black uppercase tracking-[0.14em] text-ink">Legal</h2>
      <nav class="mt-4 grid gap-3 text-sm font-bold text-ink-soft" aria-label="Footer legal navigation">
        <a class="hover:text-sky-deep" href={withBase("privacy/")}>Privacy policy</a>
        <a class="hover:text-sky-deep" href={withBase("terms/")}>Terms of service</a>
        <a class="hover:text-sky-deep" href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a>
      </nav>
    </div>
  </div>

  <div class="container-shell mt-10 flex flex-col gap-2 border-t border-[#e8efee] pt-6 text-xs leading-6 text-[#7c899c] sm:flex-row sm:items-center sm:justify-between">
    <p>© {year} {siteConfig.owner}. All rights reserved.</p>
    <p>{siteConfig.name} · {siteConfig.brand}</p>
  </div>
</footer>
