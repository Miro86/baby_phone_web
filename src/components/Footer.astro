---
import { createTranslator, getLocale } from "../i18n/ui";
import AppMark from "./AppMark.astro";
import { siteConfig } from "../config";
import { localizedPath } from "../utils/urls";
const locale = getLocale(Astro.url);
const t = createTranslator(locale);
const withBase = (path = "") => localizedPath(path, locale);
const year = new Date().getUTCFullYear();
---

<footer class="site-footer">
  <div class="container-shell footer-grid">
    <div class="footer-brand">
      <AppMark />
      <p>
        {t("m346")}
        <br />
        {t("m347")}
      </p>
    </div>
    <div>
      <h2>{t("m348")}</h2>
      <nav aria-label={t("m349")}>
        <a href={withBase()}>{t("m135")}</a>
        <a href={withBase("features/")}>{t("m415")}</a>
        <a href={withBase("parents/")}>{t("m136")}</a>
        <a href={withBase("contact/")}>{t("m231")}</a>
      </nav>
    </div>
    <div>
      <h2>{t("m350")}</h2>
      <nav aria-label={t("m351")}>
        <a href={withBase("privacy/")}>{t("m250")}</a>
        <a href={withBase("terms/")}>{t("m251")}</a>
        <a href={siteConfig.googlePlayUrl} target="_blank" rel="noopener noreferrer">
          {t("m352")}
        </a>
      </nav>
    </div>
    <div class="footer-contact">
      <h2>{t("m353")}</h2>
      <a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a>
      <p>
        {t("m354")}
        <br />
        {t("m355")}
      </p>
    </div>
  </div>
  <div class="container-shell footer-bottom">
    <p>
      © {year} {siteConfig.brandDisplay}
    </p>
    <p>{t("m356")}</p>
  </div>
</footer>
