---
import AppMark from "./AppMark.astro";
import { siteConfig } from "../config";
import { withBase } from "../utils/urls";
const year = new Date().getUTCFullYear();
---

<footer class="site-footer">
  <div class="container-shell footer-grid">
    <div class="footer-brand">
      <AppMark />
      <p>
        Small apps. Big adventures.
        <br />
        Playful discovery for little explorers.
      </p>
    </div>
    <div>
      <h2>Explore</h2>
      <nav aria-label="Footer navigation">
        <a href={withBase()}>Home</a>
        <a href={withBase("features/")}>Baby Phone</a>
        <a href={withBase("parents/")}>For parents</a>
        <a href={withBase("contact/")}>Contact</a>
      </nav>
    </div>
    <div>
      <h2>The details</h2>
      <nav aria-label="Legal navigation">
        <a href={withBase("privacy/")}>Privacy policy</a>
        <a href={withBase("terms/")}>Terms of service</a>
        <a href={siteConfig.googlePlayUrl} rel="external">
          Baby Phone on Google Play
        </a>
      </nav>
    </div>
    <div class="footer-contact">
      <h2>Say hello</h2>
      <a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a>
      <p>
        A question or a little idea?
        <br />
        We’d love to hear from you.
      </p>
    </div>
  </div>
  <div class="container-shell footer-bottom">
    <p>
      © {year} {siteConfig.owner} · {siteConfig.brand}
    </p>
    <p>Made with heart. Made for play.</p>
  </div>
</footer>
